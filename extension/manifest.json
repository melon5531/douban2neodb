{
  "manifest_version": 3,
  "name": "离豆 · 豆瓣 → NeoDB 实时同步",
  "version": "1.1.0",
  "description": "在豆瓣网页标记/打分/写短评时实时同步到 NeoDB，并支持一键迁移全部历史标记。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "https://neodb.social/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "离豆 · 豆瓣 → NeoDB 同步",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.douban.com/*"
      ],
      "js": [
        "inject/hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.douban.com/*"
      ],
      "js": [
        "content/douban.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://movie.douban.com/*"
      ],
      "js": [
        "content/migrate.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
